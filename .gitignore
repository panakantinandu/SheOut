# Secrets
.env
.env.local

# Java / Maven
backend/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
hs_err_pid*

# Locally-stored dev uploads (LocalDiskDocumentStorage default)
backend/data/

# Node / frontend (npm workspaces hoist most deps to the repo-root node_modules)
node_modules/
frontend/*/node_modules/
frontend/*/dist/
frontend/*/dev-dist/
frontend/*/.vite/
*.tsbuildinfo

# IDE
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Claude Code harness state - not project source
.claude/

# Vercel CLI link state, and the per-app build-config files used only for
# local CLI deploys (vercel.json). Deliberately NOT committed: this repo
# has two Vercel projects (customer-app, driver-app) watching the same
# GitHub repo, so a single committed vercel.json would apply to whichever
# project's git-triggered build runs next - wrong for one of the two.
# Each project's git-push auto-deploy instead needs its own "Root
# Directory" set in that project's Vercel dashboard settings (see README).
.vercel
vercel*.json
