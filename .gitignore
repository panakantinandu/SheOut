# Secrets
.env
.env.local

# Java / Maven
backend/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
hs_err_pid*

# Locally-stored dev uploads (LocalDiskDocumentStorage default)
backend/data/

# Node / frontend (npm workspaces hoist most deps to the repo-root node_modules)
node_modules/
frontend/*/node_modules/
frontend/*/dist/
frontend/*/dev-dist/
frontend/*/.vite/
*.tsbuildinfo

# IDE
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Claude Code harness state - not project source
.claude/

# Vercel CLI link state, and any root-level vercel.json used for local CLI
# deploys. A ROOT vercel.json still must not be committed: both Vercel
# projects watch this one repo, so a single root config would apply to
# whichever project's build runs next - wrong for one of the two.
.vercel
/vercel*.json
frontend/*/.vercel

# The PER-APP vercel.json files ARE committed, and must be. Each project's
# Root Directory now points at its own app folder, so these apply to one
# project each - the ambiguity that kept them out of the repo is gone.
# They carry the SPA rewrite: Vercel's Vite preset does NOT add a catch-all
# to index.html, so without this every deep link (/login, /home, a shared
# booking URL) returns a hard 404 on first visit. It only looked fine
# because the service worker served index.html for repeat visitors.
!frontend/customer-app/vercel.json
!frontend/driver-app/vercel.json
