# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file (it is gitignored).
#
# These vars are for LOCAL dev (docker-compose / `mvn spring-boot:run` with
# SPRING_PROFILES_ACTIVE=local). Render deploys use a different set -
# DATABASE_URL / REDIS_URL - set directly in the Render dashboard, not here.
# See the "Deploying to Render" section of the README.

# --- Local Postgres (used by docker-compose) ---
PORT=8080
DB_NAME=sheout
DB_USERNAME=sheout
DB_PASSWORD=sheout

# --- Local Redis (no auth by default in docker-compose) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- CORS: browser origins allowed to call this API ---
# Defaults already cover the frontend apps' local dev ports (Vite
# auto-increments if 5173/5174 are taken, hence 5175 too) - override only
# if you're serving a frontend from somewhere else.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Auth: OTP + session tokens ---
# JWT_SECRET has a dev-only default in application-local.yml, so it's safe
# to leave unset locally. Required (no default) on Render - see README.
# Must be a strong random value, at least 32 bytes, e.g.: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=43200
# Only for an old phone-and-code ADMIN token, accepted while
# ADMIN_PHONE_LOGIN_ENABLED is on (never in production).
ADMIN_JWT_EXPIRY_MINUTES=720

# --- Staff accounts (the ops console) - README "Staff accounts and roles" ---
# REQUIRED outside the local profile: encrypts authenticator secrets.
# openssl rand -base64 32. Changing it means every staff member re-enrols.
STAFF_SECRETS_KEY=
# With no active OWNER, each start invites this address as the first OWNER.
SHEOUT_OWNER_BOOTSTRAP_EMAIL=
# Where the console lives, for links in invitation emails.
STAFF_CONSOLE_URL=http://localhost:8080/admin/
STAFF_INVITE_HOURS=24
STAFF_SESSION_IDLE_MINUTES=30
STAFF_SESSION_ABSOLUTE_HOURS=8
STAFF_SESSION_IDLE_MINUTES_OWNER=15
STAFF_SESSION_ABSOLUTE_HOURS_OWNER=8
STAFF_SESSION_IDLE_MINUTES_SAFETY_RESPONDER=60
STAFF_SESSION_ABSOLUTE_HOURS_SAFETY_RESPONDER=12
STAFF_AUDITOR_DEFAULT_DAYS=30
STAFF_STEP_UP_MINUTES=5
STAFF_ALERT_ACCESS_MINUTES=30
STAFF_AUDIT_CHECK_CRON=0 30 3 * * *
# Rupees a role may refund without an owner's approval.
REFUND_LIMIT_SUPPORT=200
REFUND_LIMIT_MANAGER=1000
REFUND_LIMIT_FINANCE=200
# Off when blank. Comma-separated addresses or CIDR ranges, e.g. 203.0.113.0/24
STAFF_IP_ALLOWLIST_OWNER=
STAFF_IP_ALLOWLIST_FINANCE=
# ...and likewise _MANAGER, _VERIFICATION_AGENT, _SUPPORT_AGENT,
# _SAFETY_RESPONDER, _MARKETPLACE_MODERATOR, _AUDITOR.
STAFF_LOGIN_MAX_FAILURES=5
STAFF_LOGIN_LOCK_MINUTES=15
STAFF_LOGIN_PER_ADDRESS=20
STAFF_COOKIE_SECURE=true
# The old phone-and-code way into the console. false in production.
# The local profile turns it on so local scripts keep working.
ADMIN_PHONE_LOGIN_ENABLED=false
# Optional: the founder's old phone-login ADMIN account, adopted by the first
# OWNER so her earlier decisions stay attributed to her. Grants nothing.
ADMIN_BOOTSTRAP_PHONE=
OTP_TTL_SECONDS=300

# --- driver-verification: document storage ---
# local (default, writes to disk - dev only) or s3
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_LOCAL_PATH=./data/documents
# Only used when DOCUMENT_STORAGE_PROVIDER=s3:
DOCUMENT_STORAGE_S3_BUCKET=
DOCUMENT_STORAGE_S3_REGION=ap-south-1
# Only set this for a non-AWS S3-compatible provider - leave empty for real AWS S3.
DOCUMENT_STORAGE_S3_ENDPOINT=
DOCUMENT_STORAGE_S3_PRESIGN_EXPIRY_MINUTES=15
# S3 credentials are read via the AWS SDK's own default chain, not a
# SheOut-specific var - set these two (standard AWS SDK env var names) when
# DOCUMENT_STORAGE_PROVIDER=s3:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Dispatch: matching tuning (all optional, sensible defaults baked ---
# --- into application.yml - see the dispatch module's README section   ---
# --- for why these specific numbers are guesses, not a spec)           ---
DISPATCH_INITIAL_RADIUS_KM=3.0
DISPATCH_RADIUS_EXPANSION_FACTOR=2.0
DISPATCH_CANDIDATE_COUNT=5
DISPATCH_OFFER_WINDOW_SECONDS=15
DISPATCH_MAX_RETRIES=3
# Total time dispatch may spend searching for one booking, across all
# rounds. NOT the per-offer accept window above - that bounds one driver
# answering one offer; this bounds the whole hunt. Whichever runs out
# first ends the search and the booking becomes NO_DRIVERS_AVAILABLE.
SEARCH_TIMEOUT_SECONDS=90
DISPATCH_SWEEP_INTERVAL_MS=2000

# --- Razorpay (payments module) ---
# Test-mode key id/secret from the Razorpay dashboard (Settings > API Keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configured alongside this endpoint's URL under the dashboard's Webhooks
# section (Settings > Webhooks) - required to verify that a webhook call
# genuinely came from Razorpay before trusting its payload.
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase (push notifications - not implemented yet; NOT used for OTP ---
# --- delivery - see OtpSender's Javadoc for why. See NotificationChannel's ---
# --- Javadoc for why push has no implementation yet even though this      ---
# --- module now exists: no device-token registration exists anywhere in   ---
# --- this app for a push send to target.)                                ---
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# --- Twilio (notifications module: general SMS + SOS alerts) ---
# From the Twilio Console (console.twilio.com) - Account SID + Auth Token
# from the dashboard, From Number from a purchased/verified Twilio number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Render-only, for reference (do NOT set these locally - leaving them ---
# --- unset locally is what makes the `local` Spring profile take over)   ---
# DATABASE_URL - Neon/Supabase connection string, converted to JDBC form:
#   jdbc:postgresql://<host>/<dbname>?user=<user>&password=<pass>&sslmode=require
# REDIS_URL - Upstash connection string, used as-is:
#   rediss://default:<password>@<host>:<port>

# --- Fare engine (booking module) ---
# Pricing lives entirely in configuration - there is not a rupee value in
# the fare code. These defaults are a STARTING HYPOTHESIS shaped from
# Rapido's published Hyderabad structure, NOT a final price. None has been
# checked against what it costs a woman here to run a scooter for an hour;
# the first real driver feedback should move them.
#
# fare = base + (perKm x km) + (perMinute x minutes), then x surge, then
# x night if inside the window, then floored at the minimum.
BIKE_BASE_FARE=22.00
BIKE_PER_KM_RATE=9.00
BIKE_PER_MINUTE_RATE=1.20
BIKE_MINIMUM_FARE=37.00
BIKE_NIGHT_MULTIPLIER=1.30
BIKE_NIGHT_WINDOW_START=22:00
BIKE_NIGHT_WINDOW_END=06:00
# The slot real demand-based surge will fill. 1.00 means no surge.
BIKE_SURGE_MULTIPLIER=1.00

# A parcel has no passenger, so time in traffic costs a partner less than
# carrying somebody through it - hence the lower per-minute rate.
PARCEL_BASE_FARE=25.00
PARCEL_PER_KM_RATE=10.00
PARCEL_PER_MINUTE_RATE=1.00
PARCEL_MINIMUM_FARE=40.00
PARCEL_NIGHT_MULTIPLIER=1.30
PARCEL_NIGHT_WINDOW_START=22:00
PARCEL_NIGHT_WINDOW_END=06:00
PARCEL_SURGE_MULTIPLIER=1.00

# Night windows are wall-clock. Render runs in UTC; reading a 22:00-06:00
# window in UTC would apply the surcharge over breakfast and nothing at
# midnight.
FARE_TIMEZONE=Asia/Kolkata

# --- Routing (OSRM) ---
# THE PUBLIC DEMO SERVER IS A DEBT. router.project-osrm.org has documented
# rate limits, no uptime guarantee and no support. Self-host (it ships a
# Docker image) once real traffic justifies it, then point this at it.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=4000
# Used only when routing is unavailable, so a rider can still book. Erring
# high is deliberate - the error then costs the rider a little, not the
# partner.
ROAD_DISTANCE_FACTOR=1.4
FALLBACK_SPEED_KMPH=22

# --- Platform commission (payments module) ---
# The rider pays the full fare; this is what the platform keeps of it. The
# partner's payout and this rate are both stored on the payment, so the
# margin is never silently folded into a higher customer-facing price.
PLATFORM_COMMISSION_PERCENT=18.00
# The 2025 aggregator guidelines: a partner on her own vehicle keeps at least
# 80% of the fare. A commission above this stops the server starting.
PLATFORM_COMMISSION_MAX_PERCENT=20.00

# --- GST (payments module) ---
# OFF until SheOut has a GSTIN and its CA has signed off every rate, the SAC
# codes, who the supplier is under Section 9(5) and the invoice format. On
# with anything missing, the server refuses to start. Prices stay
# tax-inclusive: the rider pays the price she was shown and the tax is found
# inside it. Every rate and code below is deliberately empty.
GST_ENABLED=false
SHEOUT_GSTIN=
SHEOUT_LEGAL_NAME=
FARES_TAX_INCLUSIVE=true
GST_PLACE_OF_SUPPLY=Telangana (36)
GST_INVOICE_PREFIX=SO
GST_RATE_BIKE=
GST_RATE_AUTO=
GST_RATE_CAB=
GST_RATE_PARCEL=
GST_RATE_PLATFORM_FEE=
GST_RATE_SELLER_LISTING_FEE=
GST_SAC_BIKE=
GST_SAC_AUTO=
GST_SAC_CAB=
GST_SAC_PARCEL=
GST_SAC_PLATFORM_FEE=
GST_SAC_SELLER_LISTING_FEE=

# --- Partner documents (driver-verification module) ---
# Which services a partner on each vehicle can be sent on. Repeats dispatch's
# rule (parcels go to bikes); change both together.
PARTNER_SERVICES_BIKE=BIKE,PARCEL
PARTNER_SERVICES_AUTO=AUTO
PARTNER_SERVICES_CAB=CAB
# What each service needs approved and in date before she can take a trip.
# Names: DRIVING_LICENCE, VEHICLE_RC, VEHICLE_INSURANCE, PUC,
# FITNESS_CERTIFICATE. An unknown name stops the server starting.
PARTNER_DOCS_BIKE=DRIVING_LICENCE,VEHICLE_RC,VEHICLE_INSURANCE,PUC
PARTNER_DOCS_AUTO=DRIVING_LICENCE,VEHICLE_RC,VEHICLE_INSURANCE,PUC,FITNESS_CERTIFICATE
PARTNER_DOCS_CAB=DRIVING_LICENCE,VEHICLE_RC,VEHICLE_INSURANCE,PUC,FITNESS_CERTIFICATE
PARTNER_DOCS_PARCEL=DRIVING_LICENCE,VEHICLE_RC,VEHICLE_INSURANCE,PUC
# Services that carry a paying passenger: her policy must be for commercial
# use, because a private one can be refused for exactly those trips.
COMMERCIAL_INSURANCE_SERVICES=BIKE,AUTO,CAB
# Reminders before a document expires, in days.
DOCUMENT_REMINDER_DAYS=30,7,1
PARTNER_DOCUMENT_SWEEP_INTERVAL_MS=3600000
# The rollout switch, not a bypass. true: a missing, unapproved or expired
# document keeps her offline. false: she is shown what is missing but can
# still go online - only for the days between deploying this and existing
# partners' documents being reviewed. See the README.
PARTNER_DOCUMENTS_REQUIRED_TO_GO_ONLINE=true

# --- Police verification (driver-verification module) ---
# How long a police check stands before it must be redone. An assumption,
# not a rule anybody has given us: confirm with the lawyer.
POLICE_REVERIFY_MONTHS=12
# Whether a private background check alone can make a police check
# VERIFIED. false: it may be attached beside a police certificate only.
# Whether it satisfies "police verification" in Telangana is a legal question.
POLICE_ACCEPT_THIRD_PARTY_BGV_ALONE=false
POLICE_REVERIFY_REMINDER_DAYS=30,7
# Must equal VERIFICATION_CONSENT_VERSION in
# frontend/design-system/src/legal/content.ts. Bump both together when the
# consent wording changes; every partner is then asked to agree again.
VERIFICATION_CONSENT_VERSION=2026-10-03-draft
# Background-verification vendor. Only "manual" exists (operators record
# results; the provider webhook answers 404). A vendor is a new
# VerificationProvider implementation plus these two.
VERIFICATION_PROVIDER=manual
VERIFICATION_PROVIDER_WEBHOOK_SECRET=
VERIFICATION_PROVIDER_SIGNATURE_HEADER=X-Provider-Signature

# --- Insurance (insurance module) ---
# Policies are entered in the console, never here. These three are the rules.
# true: ride requests are refused while no passenger policy is in force.
INSURANCE_REQUIRED_FOR_RIDES=false
# csv: a daily file an operator downloads and sends. api: a stub that refuses.
INSURANCE_REPORTER=csv
# true: "Insured trip" shows only once the trip is in a downloaded bordereau.
INSURANCE_BADGE_REQUIRES_REPORTED=false
